---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);

// Get all unique tags with their counts
const tagCounts = posts.reduce((acc, post) => {
  post.data.tags?.forEach((tag) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Tags" description="Browse articles by tag">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-12 text-center">
      <h1 class="font-serif text-4xl text-ink font-bold mb-4">Tags</h1>
      <p class="text-ink-lighter text-lg">Browse articles by topic</p>
    </header>
    
    <div class="flex flex-wrap justify-center gap-3">
      {sortedTags.map(([tag, count]) => (
        <a 
          href={`/tags/${tag.toLowerCase()}`}
          class="px-4 py-2 bg-parchment-100 hover:bg-forest-100 text-ink-light hover:text-forest-700 rounded-lg border border-trail/20 hover:border-forest-300 transition-colors flex items-center gap-2"
        >
          <span class="font-medium">{tag}</span>
          <span class="text-xs text-ink-lighter bg-parchment-200 px-2 py-0.5 rounded-full">{count}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
